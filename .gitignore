# Python bytecode caches
__pycache__/
*.pyc

# Crash dumps from tools that run in this workspace
*.stackdump

# Runtime path state written by the path tools (machine specific, not versioned)
.gamer-agent.local.json

# The vanilla script mirror that sync_game_scripts writes (read-only reference, not versioned)
game-scripts/

# Preview pages for the requirements discussion (the player reads them; not part of the mod)
.preview/
